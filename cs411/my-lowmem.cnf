# CS 411 (Database Systems) — untested draft (support file for Dockerfile.suggested), generated from public course materials; never run. Discussion starter only — see CommentsForClass.md in this directory; the working example is cs341/fa26/Dockerfile.

# Low-memory MySQL 8.0 overrides for a single-student container.
# Loaded after Ubuntu's mysqld.cnf (file name sorts last).
[mysqld]
datadir                         = /data/mysql
socket                          = /var/run/mysqld/mysqld.sock
bind-address                    = 127.0.0.1      # app runs in same container
mysqlx                          = OFF            # X protocol not needed (saves a listener + threads)

# Biggest single saving in 8.0: performance_schema reserves ~150-400 MB.
performance_schema              = OFF

# Academic World dataset is small (inferred tens of MB); 128M default is
# plenty, 96M is a reasonable floor that keeps MP4 queries fast.
innodb_buffer_pool_size         = 96M
innodb_log_buffer_size          = 8M
innodb_redo_log_capacity        = 64M
innodb_flush_log_at_trx_commit  = 2              # student data, durability relaxed

max_connections                 = 30
thread_cache_size               = 4
table_open_cache                = 400
table_definition_cache          = 400
tmp_table_size                  = 16M
max_heap_table_size             = 16M
sort_buffer_size                = 1M
join_buffer_size                = 1M
key_buffer_size                 = 8M
skip-name-resolve
