# =============================================================================
# CS 511 (Advanced Data Management) — SUGGESTED (UNTESTED) Dockerfile
#
# This is an untested draft, generated from public course materials.
# It has NEVER been built and NEVER been run.
# It is a starting point for a discussion with the instructor, not a working
# image: expect wrong package names, wrong versions and missing steps.
#
# Please read CommentsForClass.md in this same directory first — it says what
# we believe about this course and, more importantly, what we could not
# confirm.
#
# The one image in this repo that has actually been built is the CS 341 pilot:
# cs341/fa26/Dockerfile.
# =============================================================================

# =============================================================================
# CS 511 - Advanced Data Management (UIUC) : "data-systems research base" image
# =============================================================================
#
# DRAFT - NOT BUILT OR TESTED. Version pins are best-effort and MUST be checked
# against current upstream releases before the first build.
#
# PURPOSE
#   This is NOT the environment the student's project runs *in*. For CS 511 it is
#   the student's *dev box and Docker host*: MP1 has students author their own
#   Dockerfiles for a 3-node HDFS/Spark Compose cluster, and the MP2 Postgres
#   baseline script does `docker pull postgres` / `docker run` / `docker exec`.
#   So this image must be able to run an inner Docker daemon. See RUN FLAGS.
#
#   Deliberate omissions and why:
#     * No GUI, no X11, no desktop. Everything is CLI + ssh -L tunnels.
#     * No Hadoop/Spark tarballs baked in (see the HADOOP/SPARK note below) -
#       installing those is literally MP1's graded work. Toggle with a build arg
#       if the instructor says otherwise.
#     * No systemd. The course starts services with plain shell scripts.
#
# SOURCES for the tool list (see notes.md for full citations):
#   github.com/illinoisdata/cs511-fall2024-p1  (openjdk:8, ssh, Hadoop/Spark)
#   github.com/illinoisdata/cs511-fall2024-p2  (Rust 1.81, Polars, TPC-H,
#                                               Postgres/Presto/WanderJoin)
#   github.com/illinoisdata/cs511-fall2024-p3  (pandas, ray[default], gdown)
#
# =============================================================================

# -- Base ---------------------------------------------------------------------
# Pinned to a dated Ubuntu LTS tag. BEFORE PRODUCTION USE: replace with a digest
# pin, e.g.  FROM ubuntu@sha256:<digest>  so rebuilds are byte-reproducible.
# Ubuntu (not Debian) because the MP autograders run on GitHub `ubuntu-latest`,
# so matching the grading environment reduces surprises.
FROM ubuntu:24.04

LABEL org.opencontainers.image.title="cs511-data-systems-base"
LABEL org.opencontainers.image.description="CS 511 Advanced Data Management student environment"
LABEL org.opencontainers.image.source="https://github.com/illinoisdata"

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

# Pin every third-party component here so the whole image is versioned in one place.
ARG RUST_VERSION=1.81.0
ARG DUCKDB_VERSION=1.1.3
ARG SBT_VERSION=1.10.7
ARG INSTALL_HADOOP_SPARK=false
ARG HADOOP_VERSION=3.3.6
ARG SPARK_VERSION=3.5.3

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=America/Chicago

# -----------------------------------------------------------------------------
# 1. OS packages
# -----------------------------------------------------------------------------
# One RUN layer, `--no-install-recommends` to skip doc/GUI pull-ins, and the apt
# lists deleted in the same layer so they never reach the image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        # --- shell / quality of life ---
        bash-completion ca-certificates curl wget gnupg locales tzdata \
        less vim nano tmux screen htop procps psmisc file jq tree rsync unzip zip \
        zstd xz-utils bzip2 sudo man-db \
        # --- remote access (VS Code Remote-SSH attaches over this) ---
        openssh-server openssh-client \
        # --- version control ---
        git git-lfs \
        # --- C/C++ toolchain: DBMS source builds (Postgres, DuckDB, ClickHouse,
        #     LevelDB/RocksDB), TPC-H dbgen and TPC-DS dsdgen all need this ---
        build-essential gcc g++ clang lld make cmake ninja-build pkg-config \
        autoconf automake libtool bison flex \
        # --- headers commonly required by DBMS ./configure ---
        libreadline-dev zlib1g-dev libssl-dev libicu-dev libxml2-dev libxslt1-dev \
        libcurl4-openssl-dev libbz2-dev liblz4-dev libzstd-dev libsnappy-dev \
        libaio-dev libnuma-dev uuid-dev libpq-dev \
        # --- profiling / benchmark measurement ---
        #     `time` gives /usr/bin/time -v (max RSS); sysstat gives iostat/pidstat
        time sysstat numactl \
        # --- networking / debugging inside the Compose network ---
        iproute2 iputils-ping netcat-openbsd dnsutils net-tools socat telnet \
        # --- JVM: MP1 uses openjdk:8; keep 8 AND a modern LTS side by side ---
        openjdk-8-jdk-headless openjdk-17-jdk-headless \
        scala \
        # --- Python ---
        python3 python3-dev python3-venv python3-pip \
        # --- database clients/servers ---
        postgresql postgresql-client postgresql-contrib sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Java 17 is the default; MP1 scripts that need 8 use $JAVA8_HOME explicitly.
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-${TARGETARCH:-amd64}
ENV JAVA8_HOME=/usr/lib/jvm/java-8-openjdk-${TARGETARCH:-amd64}
ENV PATH=$JAVA_HOME/bin:$PATH

# -----------------------------------------------------------------------------
# 2. Docker CLI + Compose plugin  (NOT the daemon)
# -----------------------------------------------------------------------------
# MP1 is a Docker Compose assignment and the MP2 Postgres baseline shells out to
# `docker run`. The *daemon* comes from the runtime (Sysbox) or from rootless
# dockerd started at login - see RUN FLAGS. We only bake the client here.
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        docker-ce-cli docker-compose-plugin docker-buildx-plugin \
        docker-ce docker-ce-rootless-extras containerd.io \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 3. Rust  (MP2 DeepOLA/Wake: "tested with rustc 1.81.0")
# -----------------------------------------------------------------------------
# Installed system-wide under /opt so every student shares one toolchain rather
# than each downloading ~1.5 GB into their own home.
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo
ENV PATH=$CARGO_HOME/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path \
          --default-toolchain ${RUST_VERSION} \
          --profile minimal \
          --component rustfmt clippy && \
    chmod -R a+rX /opt/rust && \
    # students need a writable CARGO_HOME for their own crates; point it at $HOME
    # at runtime (see the profile.d snippet below) and keep /opt read-only.
    rm -rf /opt/rust/registry/cache

# -----------------------------------------------------------------------------
# 4. Python data stack  (MP3 pandas/Ray; general analysis; Jupyter)
# -----------------------------------------------------------------------------
# A system-wide venv at /opt/venv rather than --break-system-packages, so PEP 668
# is respected and students can still `pip install --user` on top.
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
# Versions intentionally left as floors, not exact pins, EXCEPT where a project
# depends on behaviour. Convert to exact == pins from a lockfile before rollout.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        # MP3 requirements.txt, verbatim
        pandas 'ray[default]' gdown \
        # analysis + plotting for project reports
        numpy scipy matplotlib seaborn \
        # columnar / embedded engines used constantly in this course
        pyarrow duckdb polars \
        # DB drivers for the Postgres / Presto baselines
        psycopg2-binary sqlalchemy trino presto-python-client \
        # notebooks (served on 127.0.0.1 only; reached via ssh -L)
        jupyterlab notebook ipykernel \
        # benchmark plumbing
        tqdm psutil tabulate pytest && \
    find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} + && \
    rm -rf /root/.cache/pip

# -----------------------------------------------------------------------------
# 5. DuckDB CLI  (fastest way to sanity-check a TPC-H .tbl file)
# -----------------------------------------------------------------------------
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) DUCK_ARCH=amd64 ;; \
      arm64) DUCK_ARCH=aarch64 ;; \
      *) DUCK_ARCH=amd64 ;; \
    esac; \
    curl -fsSL -o /tmp/duckdb.zip \
      "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-${DUCK_ARCH}.zip" && \
    unzip -d /usr/local/bin /tmp/duckdb.zip && \
    chmod 0755 /usr/local/bin/duckdb && \
    rm -f /tmp/duckdb.zip

# -----------------------------------------------------------------------------
# 6. TPC-H dbgen and TPC-DS dsdgen
# -----------------------------------------------------------------------------
# MP2 wants TPC-H .tbl files at scale=1/partition=10. dbgen is deterministic, so
# the *data* should live on a shared read-only volume (/data/tpch) generated once
# by staff -- but ship the generator so students can make ad-hoc scale factors.
#
# NOTE: the canonical TPC kits are licence-gated downloads. tpch-dbgen below is
# the widely-used community mirror; confirm licensing with the department before
# baking it into a distributed image. If that is a problem, drop this stage and
# rely entirely on the staff-generated shared volume.
RUN git clone --depth 1 https://github.com/electrum/tpch-dbgen.git /opt/tpch-dbgen && \
    make -C /opt/tpch-dbgen -j"$(nproc)" && \
    ln -s /opt/tpch-dbgen/dbgen /usr/local/bin/dbgen && \
    ln -s /opt/tpch-dbgen/qgen  /usr/local/bin/qgen && \
    rm -rf /opt/tpch-dbgen/.git
ENV DSS_CONFIG=/opt/tpch-dbgen

# -----------------------------------------------------------------------------
# 7. OPTIONAL: Hadoop + Spark
# -----------------------------------------------------------------------------
# Default OFF. Installing and configuring HDFS/Spark is the graded content of
# MP1 -- baking it in would hand students the answer. Build with
#   --build-arg INSTALL_HADOOP_SPARK=true
# only if the instructor confirms it is fine (e.g. for the group project).
RUN if [ "$INSTALL_HADOOP_SPARK" = "true" ]; then \
      set -eux; \
      curl -fsSL "https://archive.apache.org/dist/hadoop/common/hadoop-${HADOOP_VERSION}/hadoop-${HADOOP_VERSION}.tar.gz" \
        | tar -xz -C /opt && ln -s /opt/hadoop-${HADOOP_VERSION} /opt/hadoop; \
      curl -fsSL "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" \
        | tar -xz -C /opt && ln -s /opt/spark-${SPARK_VERSION}-bin-hadoop3 /opt/spark; \
      rm -rf /opt/hadoop/share/doc /opt/spark/examples/src; \
    else \
      echo "Hadoop/Spark intentionally NOT installed (MP1 graded work)."; \
    fi

# -----------------------------------------------------------------------------
# 8. sshd  (login + VS Code Remote-SSH + ssh -L port forwarding)
# -----------------------------------------------------------------------------
# Keys only, no passwords, no root login. Students' authorized_keys is mounted
# in with their persistent home, so no credentials live in the image.
RUN mkdir -p /run/sshd && \
    sed -i \
      -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/' \
      -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
      -e 's/^#\?ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' \
      -e 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' \
      -e 's/^#\?AllowTcpForwarding.*/AllowTcpForwarding yes/' \
      -e 's/^#\?X11Forwarding.*/X11Forwarding no/' \
      /etc/ssh/sshd_config && \
    printf 'AcceptEnv LANG LC_*\n' >> /etc/ssh/sshd_config

# -----------------------------------------------------------------------------
# 9. Student account
# -----------------------------------------------------------------------------
# UID 2000 is a placeholder: in production, match the campus/NFS UID so the
# persistent home volume has correct ownership. sudo is granted *inside* the
# container only (user namespace), which is required for apt/config work in MPs.
ARG STUDENT_USER=student
ARG STUDENT_UID=2000
RUN groupadd -g ${STUDENT_UID} ${STUDENT_USER} && \
    useradd -m -u ${STUDENT_UID} -g ${STUDENT_UID} -s /bin/bash ${STUDENT_USER} && \
    usermod -aG docker ${STUDENT_USER} && \
    echo "${STUDENT_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${STUDENT_USER} && \
    chmod 0440 /etc/sudoers.d/90-${STUDENT_USER}

# Environment for every login shell (sshd does not inherit ENV from the image).
RUN printf '%s\n' \
    'export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64' \
    'export JAVA8_HOME=/usr/lib/jvm/java-8-openjdk-amd64' \
    'export RUSTUP_HOME=/opt/rust/rustup' \
    '# per-student cargo home so /opt stays read-only and shareable' \
    'export CARGO_HOME=$HOME/.cargo' \
    'export CARGO_TARGET_DIR=$HOME/.cargo-target' \
    'export PATH=/opt/venv/bin:/opt/rust/cargo/bin:$HOME/.cargo/bin:$JAVA_HOME/bin:$PATH' \
    '[ -d /opt/spark ] && export SPARK_HOME=/opt/spark && export PATH=$SPARK_HOME/bin:$PATH' \
    '[ -d /opt/hadoop ] && export HADOOP_HOME=/opt/hadoop && export PATH=$HADOOP_HOME/bin:$PATH' \
    'export TPCH_DATA=/data/tpch   # shared read-only dataset volume' \
    > /etc/profile.d/10-cs511.sh && chmod 0644 /etc/profile.d/10-cs511.sh

# Mount points. /data is the shared read-only dataset volume; /scratch is
# per-student writable space that is NOT backed up.
RUN mkdir -p /data/tpch /data/tpcds /scratch && \
    chown ${STUDENT_UID}:${STUDENT_UID} /scratch

# -----------------------------------------------------------------------------
# 10. Final cleanup
# -----------------------------------------------------------------------------
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
           /root/.cache /root/.cargo/registry/cache \
           /usr/share/doc /usr/share/man /usr/share/locale/??_* && \
    find / -xdev -name '*.pyc' -delete 2>/dev/null || true

EXPOSE 22
# sshd in the foreground is PID 1. No systemd: the course's own scripts
# (start-all.sh, start-main.sh) launch services directly, so nothing needs it.
CMD ["/usr/sbin/sshd", "-D", "-e"]


# =============================================================================
# BUILD
# =============================================================================
#
#   docker build -t cs511-base:2026f -f Dockerfile .
#
#   # with Hadoop/Spark (only if the instructor approves - see section 7):
#   docker build -t cs511-base:2026f --build-arg INSTALL_HADOOP_SPARK=true .
#
#
# =============================================================================
# RECOMMENDED `docker run` FLAGS
# =============================================================================
#
# THE CRITICAL ONE: MP1 (Docker Compose cluster) and the MP2 Postgres baseline
# require the student to have a working Docker daemon *inside* this container.
# Pick ONE of the three options below.
#
# --- Option A (RECOMMENDED): Sysbox runtime, unprivileged inner dockerd -------
#
#   docker run -d \
#     --name cs511-netid \
#     --runtime=sysbox-runc \
#     --hostname cs511-netid \
#     --memory=16g --memory-swap=16g \
#     --cpus=4 \
#     --pids-limit=4096 \
#     --ulimit nofile=65536:65536 \
#     --ulimit nproc=8192:8192 \
#     --security-opt no-new-privileges \
#     -p 127.0.0.1:0:22 \
#     -v cs511-home-netid:/home/student \
#     -v /srv/datasets/tpch:/data/tpch:ro \
#     -v /srv/datasets/tpcds:/data/tpcds:ro \
#     --mount type=volume,source=cs511-scratch-netid,target=/scratch \
#     --restart=unless-stopped \
#     cs511-base:2026f
#
#   Inside, the student starts the inner daemon once per boot:
#     sudo dockerd > /tmp/dockerd.log 2>&1 &
#   (or add it to a login hook). Sysbox makes this work without --privileged.
#
# --- Option B: rootless dockerd, no special host runtime ---------------------
#   Add to the run command:
#     --security-opt seccomp=unconfined \
#     --security-opt apparmor=unconfined \
#     --device /dev/fuse
#   and inside:  dockerd-rootless-setuptool.sh install
#   Caveats: needs /etc/subuid + /etc/subgid mapping; inner storage driver must
#   be fuse-overlayfs (vfs is very slow and burns disk).
#
# --- Option C (NOT for a shared class node): privileged DinD -----------------
#     --privileged -v cs511-dind-netid:/var/lib/docker
#   Effectively host root. Use only on a single-tenant host.
#
# --- NEVER: -v /var/run/docker.sock:/var/run/docker.sock ---------------------
#   Root-equivalent on the host, and every student's containers would share one
#   namespace and collide on names and published ports.
#
#
# --- Benchmark / measurement runs (group project) ----------------------------
# Timing results from a container sharing CPU and disk with neighbours are not
# trustworthy. For a measurement run, pin the container and require the node to
# be otherwise idle:
#     --cpuset-cpus=8-15 --cpuset-mems=1 \
#     --memory=32g --memory-swap=32g \
#     --blkio-weight=1000
# Better still: reserve one of the 9 VMs as a bare "benchmark box" and book it.
#
#
# --- Ports: tunnel, do not publish -------------------------------------------
# Only 22 is exposed, and bound to 127.0.0.1 on the host behind the campus VPN.
# Everything else is reached with local forwards from the student's laptop:
#     ssh -L 8888:localhost:8888 ...   # JupyterLab
#     ssh -L 5432:localhost:5432 ...   # PostgreSQL
#     ssh -L 8080:localhost:8080 ...   # Spark master UI  (MP1)
#     ssh -L 8081:localhost:8081 ...   # Spark worker UI  (MP1)
#     ssh -L 9870:localhost:9870 ...   # HDFS NameNode UI (MP1)
#     ssh -L 8265:localhost:8265 ...   # Ray dashboard    (MP3)
# Start Jupyter bound to loopback so the tunnel is the only path in:
#     jupyter lab --no-browser --ip=127.0.0.1 --port=8888
#
#
# --- Storage sizing ----------------------------------------------------------
# Per-student writable need is ~40-80 GB (source trees, cargo target dirs, inner
# Docker layers, a loaded Postgres SF1 database) -- NOT the 1000 GB the VM
# request asks for. TPC-H .tbl data is byte-identical for every student because
# dbgen is deterministic, so staff generate SF 0.05/1/10/100 once into
# /srv/datasets/tpch and every container mounts it :ro.
# Enforce the per-student cap with an XFS project quota or a ZFS dataset quota
# on the backing volume; Docker's --storage-opt size= only works on some drivers.
# =============================================================================
